test_type = ParserTest
delimited_by = Ampersand

test_content = {
  5 + 10 - 15
  &
  -(25 * 50)
  &
  -A
  &
  --(10 * 50)
  &
  (5 + 10) * (15 + 20) / (25 - 30)
  &
  A and B
  &
  A or B
  &
  A and B or !C
  &
  A + B and C or D
  &
  A and B or not C
}

expected_parse_content = {

  ComposedExpr = (
    BinaryOpExpr["5 + 10 - 15"]
      BinaryOpExpr["5 + 10"]
        LiteralExpr["5"]
        LiteralExpr["10"]
      LiteralExpr["15"]
  )

  ComposedExpr = (
    UnaryOpExpr["-(25 * 50)"]
      BinaryOpExpr["(25 * 50)"]
        LiteralExpr["25"]
        LiteralExpr["50"]
  )

  ComposedExpr = (
    UnaryOpExpr["-A"]
      PropertyDotIdentifier["A"]
  )

  ComposedExpr = (
    UnaryOpExpr["--(10 * 50)"]
      UnaryOpExpr["-(10 * 50)"]
        BinaryOpExpr["(10 * 50)"]
          LiteralExpr["10"]
          LiteralExpr["50"]
  )

  ComposedExpr = (
    BinaryOpExpr["(5 + 10) * (15 + 20) / (25 - 30)"]
      BinaryOpExpr["(5 + 10) * (15 + 20)"]
        BinaryOpExpr["(5 + 10)"]
          LiteralExpr["5"]
          LiteralExpr["10"]
        BinaryOpExpr["(15 + 20)"]
          LiteralExpr["15"]
          LiteralExpr["20"]
      BinaryOpExpr["(25 - 30)"]
        LiteralExpr["25"]
        LiteralExpr["30"]
  )

  ComposedExpr = (
    BinaryOpExpr["A and B"]
      PropertyDotIdentifier["A"]
      PropertyDotIdentifier["B"]
  )

  ComposedExpr = (
    BinaryOpExpr["A or B"]
      PropertyDotIdentifier["A"]
      PropertyDotIdentifier["B"]
  )

  ComposedExpr = (
    BinaryOpExpr["A and B or !C"]
      BinaryOpExpr["A and B"]
        PropertyDotIdentifier["A"]
        PropertyDotIdentifier["B"]
      UnaryOpExpr["!C"]
        PropertyDotIdentifier["C"]
  )

  ComposedExpr = (
    BinaryOpExpr["A + B and C or D"]
      BinaryOpExpr["A + B and C"]
        PropertyDotIdentifier["A"]
        BinaryOpExpr["B and C"]
          PropertyDotIdentifier["B"]
          PropertyDotIdentifier["C"]
      PropertyDotIdentifier["D"]
  )

  ComposedExpr = (
    BinaryOpExpr["A and B or not C"]
      BinaryOpExpr["A and B"]
        PropertyDotIdentifier["A"]
        PropertyDotIdentifier["B"]
      UnaryOpExpr["not C"]
        PropertyDotIdentifier["C"]
  )
}

expected_text = {
  "5 + 10 - 15"
  "-(25 * 50)"
  "-A"
  "--(10 * 50)"
  "(5 + 10) * (15 + 20) / (25 - 30)"
  "A and B"
  "A or B"
  "A and B or !C"
  "A + B and C or D"
  "A and B or not C"
}