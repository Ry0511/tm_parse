expected_parse_content = {
  ObjectRef = ( DotIdentifier["foo"] )
  ObjectRef = ( DotIdentifier["foo.baz"] )
  ObjectRef = ( DotIdentifier["foo"] DotIdentifier["baz"] )
  ObjectRef = ( DotIdentifier["foo.baz"] DotIdentifier["bar"] )
}

expected_text = {
  "foo"
  "foo.baz"
  "foo:baz"
  "foo.baz:bar"
}