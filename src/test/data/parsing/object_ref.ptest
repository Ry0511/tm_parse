test_type = ParserTest

test_content = {
  foo
  foo.baz
  foo:baz
  foo.baz:bar
  $(foo.baz.bar)
  foo'baz.bar'
}

expected_parse_content = {
  ObjectRef = ( FullObjectRef["foo"]           DotIdentifier["foo"]                          )
  ObjectRef = ( FullObjectRef["foo.baz"]       DotIdentifier["foo.baz"]                      )
  ObjectRef = ( FullObjectRef["foo:baz"]       DotIdentifier["foo"]     DotIdentifier["baz"] )
  ObjectRef = ( FullObjectRef["foo.baz:bar"]   DotIdentifier["foo.baz"] DotIdentifier["bar"] )
  ObjectRef = ( MetaVarExpr["$(foo.baz.bar)"]  DotIdentifier["foo.baz.bar"]                  )
  ObjectRef = ( ClassObjectRef["foo'baz.bar'"] DotIdentifier["baz.bar"]                      )
}

expected_text = {
  "foo"
  "foo.baz"
  "foo:baz"
  "foo.baz:bar"
  "$(foo.baz.bar)"
  "foo'baz.bar'"
}