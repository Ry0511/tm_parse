test_type = ParserTest

test_content = {
  set foo baz ( 5 * 10 )
  set foo:bar baz(+1.5) 1
  set foo:bar baz[-1.5] True
}

expected_parse_content = {
  SetCommand = (
    ObjectRef
      DotIdentifier["foo"]
    PropertyAccess
      DotIdentifier["baz"]
    ParenExpr["( 5 * 10 )"]
      ComposedExpr["5 * 10"]
        BinaryOpExpr["5 * 10"]
  )

  SetCommand = (
    ObjectRef["foo:bar"]
      DotIdentifier["foo"]
      DotIdentifier["bar"]
    PropertyAccess["baz(+1.5)"]
      DotIdentifier["baz"]
      ArrayAccess["(+1.5)"]
    ComposedExpr["1"]
      LiteralExpr["1"]
  )

  SetCommand = (
      ObjectRef["foo:bar"]
        DotIdentifier["foo"]
        DotIdentifier["bar"]
      PropertyAccess["baz[-1.5]"]
        DotIdentifier["baz"]
        ArrayAccess["[-1.5]"]
      ComposedExpr["True"]
        LiteralExpr["True"]
    )
}

expected_text = {
  "set foo baz ( 5 * 10 )"
  "set foo:bar baz(+1.5) 1"
  "set foo:bar baz[-1.5] True"
  "set $(foo) $(baz) ( 5.0 * $(bar) )"
}