test_type = ParserTest

test_content = {
  set foo baz ( 5 * 10 )
  set foo:bar baz(+1.5) 1
  set foo:bar baz[-1.5] True
  set foo'baz' bar 1
  set $(foo) baz bar
}

expected_parse_content = {
  SetCommand = (
    ObjectRef
      FullObjectRef["foo"]
        DotIdentifier["foo"]
    PropertyAccess
      DotIdentifier["baz"]
    ParenExpr["( 5 * 10 )"]
      ComposedExpr["5 * 10"]
        BinaryOpExpr["5 * 10"]
  )

  SetCommand = (
    ObjectRef["foo:bar"]
      FullObjectRef["foo:bar"]
        DotIdentifier["foo"]
        DotIdentifier["bar"]
    PropertyAccess["baz(+1.5)"]
      DotIdentifier["baz"]
      ArrayAccess["(+1.5)"]
    ComposedExpr["1"]
      LiteralExpr["1"]
  )

  SetCommand = (
    ObjectRef["foo:bar"]
      FullObjectRef["foo:bar"]
        DotIdentifier["foo"]
        DotIdentifier["bar"]
    PropertyAccess["baz[-1.5]"]
      DotIdentifier["baz"]
      ArrayAccess["[-1.5]"]
    ComposedExpr["True"]
      LiteralExpr["True"]
  )

  SetCommand = (
    ObjectRef["foo'baz'"]
      ClassObjectRef["foo'baz'"]
        DotIdentifier["baz"]
    PropertyAccess["bar"]
      DotIdentifier["bar"]
    ComposedExpr["1"]
      LiteralExpr["1"]
  )

  SetCommand = (
    ObjectRef["$(foo)"]
      MetaVarExpr["$(foo)"]
        DotIdentifier["foo"]
    PropertyAccess["baz"]
      DotIdentifier["baz"]
    ComposedExpr["bar"]
      IdentifierRefExpr["bar"]
  )
}

expected_text = {
  "set foo baz ( 5 * 10 )"
  "set foo:bar baz(+1.5) 1"
  "set foo:bar baz[-1.5] True"
  "set foo'baz' bar 1"
  "set $(foo) baz bar"
}