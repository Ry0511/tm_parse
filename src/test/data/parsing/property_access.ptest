test_type = ParserTest

test_content = {
  foo
  foo(+1.0)
  foo[-1.0]
  foo.baz(0.5)
}

expected_parse_content = {
  PropertyAccess
  PropertyAccess = (DotIdentifier["foo"] ArrayAccess["(+1.0)"])
  PropertyAccess = (DotIdentifier["foo"] ArrayAccess["[-1.0]"])
  PropertyAccess = (DotIdentifier["foo.baz"] ArrayAccess["(0.5)"])
}

expected_text = {
  "foo"
  "foo(+1.0)"
  "foo[-1.0]"
  "foo.baz(0.5)"
}